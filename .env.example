# ClawBox .env.example — 环境变量模板
# 复制此文件为 .env 并填入真实值：cp .env.example .env

# GitHub Personal Access Token（用于技能安装时通过代理拉取 GitHub 仓库）
# 获取：https://github.com/settings/tokens → Generate new token (classic) → 勾选 repo
GITHUB_TOKEN=ghp_YOUR_GITHUB_TOKEN_HERE

# ClawHub Token（OpenClaw Agent 认证）
# 获取：https://clawhub.com → Settings → API Tokens
CLAWHUB_TOKEN=clh_YOUR_CLAWHUB_TOKEN_HERE

# JWT 签名密钥（32字节随机 hex，用于 API 鉴权 token 签发）
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_HEX_64_CHARS

# Sing-box 兜底节点 URI（整条 VLESS/VMess URI，由 subscription_parser 解析）
# 格式：vless://uuid@host:port?参数
SINGBOX_FALLBACK_URI=
