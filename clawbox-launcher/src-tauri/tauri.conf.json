{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clawbox Launcher",
  "version": "0.2.2",
  "identifier": "com.wmsoss.clawbox-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clawbox 启动器",
        "width": 780,
        "height": 820,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": "v1Compatible"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/wmsoss/clawbox/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCQTA1QjMxRTA0RUI2MUQKUldRZHRrN2dNVnVnbTFLb2hUcDhNZUNFWFVja01SRjlzRGhiV1JQb1NNd2wyaTJyWitMNUc2bksK"
    }
  }
}
